# Copy to .env for local development. On Render, set these as environment
# variables in the service dashboard instead - do not commit a real .env file.

OPENAI_API_KEY=
PORT=3000
ALLOWED_ORIGINS=https://axi3d.pl,https://www.axi3d.pl,http://localhost:8080
PREVIEW_RATE_LIMIT=15

# gpt-image-1 cost scales a lot with quality. low is cheapest, good enough
# for testing the prompt; bump to medium/high only once the style is right.
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1024
